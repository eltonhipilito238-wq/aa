local function updateRainbow()

	Hue =
		(Hue + 0.0025) % 1

	local rainbow =
		Color3.fromHSV(
			Hue,
			0.82,
			1
		)

	Accent.BackgroundColor3 =
		rainbow

	FOVStroke.Color =
		rainbow

	for name, button in pairs(TabButtons) do

		if name == CurrentTab then
			button.BackgroundColor3 =
				rainbow
		end
	end
end

